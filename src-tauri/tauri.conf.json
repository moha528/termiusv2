{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lynk Client",
  "version": "1.0.2",
  "identifier": "io.github.moha528.lynk",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lynk Client",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Lynk Client contributors",
    "category": "DeveloperTool",
    "shortDescription": "Client SSH/SFTP desktop libre",
    "longDescription": "Lynk Client — client SSH/SFTP desktop multiplateforme, local-first et chiffré : terminal multi-onglets, SFTP dual-pane, snippets, identities, sync Git chiffrée.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 Lynk Client contributors",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installMode": "both",
        "languages": ["English", "French"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "dmg": {
        "background": "installer/dmg-background.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 175, "y": 205 },
        "applicationFolderPosition": { "x": 485, "y": 205 }
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/moha528/lynk/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDMzE0OEVDRDdCN0JBM0UKUldRK3VyZlg3RWd4VE54aVNBUmJ0aVRqSFlRQm4yTzc1WDE4NzcvVjJHQWZvb043TE9FcVdsU2gK"
    }
  }
}
